<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-1">
  
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-white flex items-center gap-3">
        <i class="fa-solid fa-tags text-emerald-400"></i> Danh mục Gói tập & Dịch vụ
      </h1>
      <p class="text-slate-400 text-sm mt-1">Các gói dịch vụ tập luyện và kèm riêng Huấn luyện viên cá nhân (PT)</p>
    </div>

    <div class="flex gap-3">
      <button onclick="document.getElementById('buyPackageModal').classList.remove('hidden')"
        class="px-4 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-sm flex items-center gap-2 shadow-lg shadow-emerald-500/20 transition-all">
        <i class="fa-solid fa-cart-plus"></i> Đăng ký / Gia hạn Gói cho Hội viên
      </button>
      <% if (user.role === 'ADMIN' || user.role === 'OWNER') { %>
        <button onclick="document.getElementById('addPackageModal').classList.remove('hidden')"
          class="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-semibold text-sm border border-slate-700 flex items-center gap-2 transition-all">
          <i class="fa-solid fa-plus"></i> Tạo Gói mới
        </button>
      <% } %>
    </div>
  </div>

  <% if (message) { %>
    <div class="mb-6 p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-sm flex items-center gap-3">
      <i class="fa-solid fa-circle-check"></i>
      <span><%= message %></span>
    </div>
  <% } %>

  <% if (error) { %>
    <div class="mb-6 p-4 rounded-xl bg-red-500/10 border border-red-500/30 text-red-400 text-sm flex items-center gap-3">
      <i class="fa-solid fa-circle-exclamation"></i>
      <span><%= error %></span>
    </div>
  <% } %>

  <!-- Packages Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <% packages.forEach(pkg => { %>
      <div class="p-6 rounded-2xl bg-slate-900/90 border border-slate-800 hover:border-emerald-500/50 shadow-xl flex flex-col justify-between transition-all transform hover:-translate-y-1">
        <div>
          <div class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 mb-3">
            <%= pkg.duration_days %> NGÀY
          </div>
          <h3 class="text-xl font-black text-white"><%= pkg.name %></h3>
          <p class="text-slate-400 text-xs mt-2 min-h-[48px]"><%= pkg.description %></p>
          
          <div class="mt-4 pt-4 border-t border-slate-800">
            <div class="text-2xl font-black text-white">
              <%= Number(pkg.price).toLocaleString('vi-VN') %> <span class="text-xs text-slate-400 font-normal">VNĐ</span>
            </div>
            <div class="text-xs text-amber-400 font-semibold mt-2 flex items-center gap-1.5">
              <i class="fa-solid fa-user-ninja"></i>
              <span><%= pkg.pt_sessions > 0 ? `Bao gồm ${pkg.pt_sessions} buổi tập cùng PT` : 'Tập tự do không kèm PT' %></span>
            </div>
          </div>
        </div>

        <button onclick="openBuyModalForPackage('<%= pkg.id %>')"
          class="mt-6 w-full py-2.5 rounded-xl bg-slate-800 hover:bg-emerald-500 hover:text-slate-950 text-white font-bold text-xs border border-slate-700 transition-all">
          Đăng ký gói này
        </button>
      </div>
    <% }) %>
  </div>

  <!-- Modal Đăng ký gói cho Hội viên -->
  <div id="buyPackageModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-sm">
    <div class="w-full max-w-md bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-2xl">
      <div class="flex items-center justify-between pb-4 border-b border-slate-800 mb-4">
        <h3 class="text-lg font-bold text-white flex items-center gap-2">
          <i class="fa-solid fa-cart-shopping text-emerald-400"></i> Đăng ký Gói cho Hội viên
        </h3>
        <button onclick="document.getElementById('buyPackageModal').classList.add('hidden')" class="text-slate-400 hover:text-white">
          <i class="fa-solid fa-xmark text-lg"></i>
        </button>
      </div>

      <form action="/packages/buy" method="POST" class="space-y-4">
        <div>
          <label class="block text-xs font-bold uppercase text-slate-300 mb-1">Chọn Hội viên*</label>
          <select name="user_id" required class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-xl text-white text-sm focus:border-emerald-500">
            <% members.forEach(m => { %>
              <option value="<%= m.id %>"><%= m.full_name %> (<%= m.phone %>)</option>
            <% }) %>
          </select>
        </div>

        <div>
          <label class="block text-xs font-bold uppercase text-slate-300 mb-1">Gói tập đăng ký*</label>
          <select id="selectPackageInput" name="package_id" required class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-xl text-white text-sm focus:border-emerald-500">
            <% packages.forEach(p => { %>
              <option value="<%= p.id %>"><%= p.name %> - <%= Number(p.price).toLocaleString('vi-VN') %> VNĐ</option>
            <% }) %>
          </select>
        </div>

        <div>
          <label class="block text-xs font-bold uppercase text-slate-300 mb-1">Phương thức thanh toán*</label>
          <select name="payment_method" class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-xl text-white text-sm focus:border-emerald-500">
            <option value="CASH">Tiền mặt tại quầy</option>
            <option value="BANK_TRANSFER">Chuyển khoản ngân hàng</option>
            <option value="MOMO">Ví MoMo</option>
            <option value="VNPAY">VNPAY-QR</option>
          </select>
        </div>

        <div class="flex justify-end gap-3 pt-4 border-t border-slate-800">
          <button type="button" onclick="document.getElementById('buyPackageModal').classList.add('hidden')"
            class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-sm">Hủy</button>
          <button type="submit"
            class="px-5 py-2 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-sm">
            Xác nhận Kích hoạt & Thu tiền
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal Tạo Gói tập mới (Admin / Owner) -->
  <div id="addPackageModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/70 backdrop-blur-sm">
    <div class="w-full max-w-md bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-2xl">
      <div class="flex items-center justify-between pb-4 border-b border-slate-800 mb-4">
        <h3 class="text-lg font-bold text-white flex items-center gap-2">
          <i class="fa-solid fa-plus text-emerald-400"></i> Thêm Gói tập mới
        </h3>
        <button onclick="document.getElementById('addPackageModal').classList.add('hidden')" class="text-slate-400 hover:text-white">
          <i class="fa-solid fa-xmark text-lg"></i>
        </button>
      </div>

      <form action="/packages/create" method="POST" class="space-y-4">
        <div>
          <label class="block text-xs font-bold uppercase text-slate-300 mb-1">Tên Gói tập*</label>
          <input type="text" name="name" required placeholder="Gói 6 Tháng Vàng..."
            class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-xl text-white text-sm focus:border-emerald-500">
        </div>
        <div>
          <label class="block text-xs font-bold uppercase text-slate-300 mb-1">Mô tả quyền lợi</label>
          <textarea name="description" rows="2" placeholder="Chi tiết dịch vụ..."
            class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-xl text-white text-sm focus:border-emerald-500"></textarea>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-bold uppercase text-slate-300 mb-1">Thời hạn (ngày)*</label>
            <input type="number" name="duration_days" required value="30"
              class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-xl text-white text-sm focus:border-emerald-500">
          </div>
          <div>
            <label class="block text-xs font-bold uppercase text-slate-300 mb-1">Số buổi PT</label>
            <input type="number" name="pt_sessions" value="0"
              class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-xl text-white text-sm focus:border-emerald-500">
          </div>
        </div>
        <div>
          <label class="block text-xs font-bold uppercase text-slate-300 mb-1">Giá tiền (VNĐ)*</label>
          <input type="number" name="price" required placeholder="500000"
            class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-xl text-white text-sm focus:border-emerald-500">
        </div>

        <div class="flex justify-end gap-3 pt-4 border-t border-slate-800">
          <button type="button" onclick="document.getElementById('addPackageModal').classList.add('hidden')"
            class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-sm">Hủy</button>
          <button type="submit"
            class="px-5 py-2 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-sm">
            Lưu Gói Tập
          </button>
        </div>
      </form>
    </div>
  </div>

</main>

<script>
  function openBuyModalForPackage(pkgId) {
    document.getElementById('selectPackageInput').value = pkgId;
    document.getElementById('buyPackageModal').classList.remove('hidden');
  }
</script>

<%- include('partials/footer') %>
