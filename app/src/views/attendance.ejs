<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-1">
  
  <div class="mb-8">
    <h1 class="text-2xl sm:text-3xl font-extrabold text-white flex items-center gap-3">
      <i class="fa-solid fa-id-card-clip text-emerald-400"></i> Quầy Điểm danh Check-in
    </h1>
    <p class="text-slate-400 text-sm mt-1">Kiểm tra thời hạn gói tập và ghi nhận lượt vào phòng tập Gym</p>
  </div>

  <!-- Kết quả điểm danh (Nghiệp vụ cốt lõi theo file Phòng Gym.docx) -->
  <% if (checkinResult) { %>
    <% if (checkinResult.success) { %>
      <div class="mb-8 p-6 rounded-2xl bg-emerald-500/15 border-2 border-emerald-500/40 text-emerald-300 shadow-2xl animate-fade-in">
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 rounded-xl bg-emerald-500 text-slate-950 flex items-center justify-center text-2xl font-black shrink-0">
            <i class="fa-solid fa-check"></i>
          </div>
          <div class="flex-1">
            <h3 class="text-xl font-black text-white">CHECK-IN HỢP LỆ — CHO PHÉP VÀO TẬP</h3>
            <p class="mt-1 text-emerald-200"><%= checkinResult.message %></p>
            <div class="mt-4 grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs bg-slate-950/60 p-3 rounded-xl border border-emerald-500/20">
              <div><span class="text-slate-400">Hội viên:</span> <strong class="text-white block"><%= checkinResult.member.full_name %></strong></div>
              <div><span class="text-slate-400">Số ĐT:</span> <strong class="text-white block"><%= checkinResult.member.phone %></strong></div>
              <div><span class="text-slate-400">Gói tập:</span> <strong class="text-emerald-400 block"><%= checkinResult.package.package_name %></strong></div>
              <div><span class="text-slate-400">Hết hạn vào:</span> <strong class="text-white block"><%= new Date(checkinResult.package.end_date).toLocaleDateString('vi-VN') %></strong></div>
            </div>
          </div>
        </div>
      </div>
    <% } else { %>
      <div class="mb-8 p-6 rounded-2xl bg-red-500/15 border-2 border-red-500/40 text-red-300 shadow-2xl animate-fade-in">
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 rounded-xl bg-red-500 text-white flex items-center justify-center text-2xl font-black shrink-0">
            <i class="fa-solid fa-ban"></i>
          </div>
          <div class="flex-1">
            <h3 class="text-xl font-black text-white">TỪ CHỐI CHECK-IN — GÓI KHÔNG HỢP LỆ</h3>
            <p class="mt-1 text-red-200"><%= checkinResult.message %></p>
            <p class="text-xs text-red-400 mt-2">Vui lòng hướng dẫn hội viên gia hạn gói tập tại quầy lễ tân để tiếp tục sử dụng dịch vụ.</p>
          </div>
        </div>
      </div>
    <% } %>
  <% } %>

  <!-- Form Điểm danh nhanh tại quầy -->
  <div class="p-6 rounded-2xl bg-slate-900/90 border border-slate-800 shadow-xl mb-8">
    <h2 class="text-base font-bold text-white uppercase tracking-wider mb-4 flex items-center gap-2">
      <i class="fa-solid fa-qrcode text-emerald-400"></i> Quét mã hoặc Nhập thông tin Hội viên
    </h2>
    <form action="/attendance/checkin" method="POST" class="flex flex-col sm:flex-row gap-3">
      <div class="relative flex-1">
        <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-500">
          <i class="fa-solid fa-fingerprint text-emerald-400"></i>
        </span>
        <input type="text" name="identifier" required autofocus
          placeholder="Nhập Mã Hội viên (ID), Số điện thoại hoặc Username để check-in..."
          class="w-full pl-10 pr-4 py-3 bg-slate-950 border border-slate-800 rounded-xl text-white text-base focus:outline-none focus:border-emerald-500 font-medium">
      </div>
      <button type="submit"
        class="py-3 px-8 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-slate-950 font-black text-base shadow-lg shadow-emerald-500/25 transition-all">
        KIỂM TRA & CHECK-IN
      </button>
    </form>
  </div>

  <!-- Danh sách lịch sử điểm danh -->
  <div class="rounded-2xl bg-slate-900/80 border border-slate-800 shadow-lg overflow-hidden">
    <div class="p-4 bg-slate-950/60 border-b border-slate-800 flex items-center justify-between">
      <h3 class="text-sm font-bold text-white uppercase tracking-wider">Lịch sử Lượt ra / vào gần nhất</h3>
      <span class="text-xs text-slate-400 font-mono">Hiển thị 20 lượt gần đây</span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="text-xs text-slate-400 uppercase bg-slate-950/40 border-b border-slate-800">
          <tr>
            <th class="py-3 px-4">Hội viên</th>
            <th class="py-3 px-4">Gói tập</th>
            <th class="py-3 px-4">Giờ vào (Check-in)</th>
            <th class="py-3 px-4">Giờ ra (Check-out)</th>
            <th class="py-3 px-4">Kết quả</th>
            <th class="py-3 px-4 text-right">Thao tác</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800">
          <% if (logs.length === 0) { %>
            <tr>
              <td colspan="6" class="py-6 text-center text-slate-500">Chưa có lượt điểm danh nào.</td>
            </tr>
          <% } %>
          <% logs.forEach(log => { %>
            <tr class="hover:bg-slate-800/40 transition-colors">
              <td class="py-3 px-4">
                <div class="font-bold text-white"><%= log.full_name %></div>
                <div class="text-xs text-slate-400 font-mono">ĐT: <%= log.phone %></div>
              </td>
              <td class="py-3 px-4 text-slate-300"><%= log.package_name || 'Không có' %></td>
              <td class="py-3 px-4 font-mono text-xs text-emerald-400">
                <%= new Date(log.check_in_time).toLocaleString('vi-VN') %>
              </td>
              <td class="py-3 px-4 font-mono text-xs text-slate-400">
                <%= log.check_out_time ? new Date(log.check_out_time).toLocaleString('vi-VN') : 'Đang tập' %>
              </td>
              <td class="py-3 px-4">
                <% if (log.status === 'VALID') { %>
                  <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                    Hợp lệ
                  </span>
                <% } else { %>
                  <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-red-500/10 text-red-400 border border-red-500/20">
                    Từ chối (Hết hạn)
                  </span>
                <% } %>
              </td>
              <td class="py-3 px-4 text-right">
                <% if (log.status === 'VALID' && !log.check_out_time) { %>
                  <form action="/attendance/checkout/<%= log.id %>" method="POST" class="inline">
                    <button type="submit" class="px-3 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-200 border border-slate-700">
                      Check-out
                    </button>
                  </form>
                <% } else { %>
                  <span class="text-xs text-slate-500">Hoàn tất</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

</main>

<%- include('partials/footer') %>
